{
  "version": 1,
  "sections": {
    "A": {
      "title": "上下文管理",
      "weight": 25,
      "desc": "上下文是最稀缺的资源，满了就会忘事"
    },
    "B": {
      "title": "任务方法",
      "weight": 25,
      "desc": "先探索、再计划、再动手，并且让 Agent 能自己验证"
    },
    "C": {
      "title": "配置卫生",
      "weight": 20,
      "desc": "规则文件、Skill、MCP、权限配得合不合理"
    },
    "D": {
      "title": "效率",
      "weight": 10,
      "desc": "缓存命中；模型怎么挑只作参考"
    },
    "E": {
      "title": "结果信号",
      "weight": 20,
      "desc": "你多常需要指出“不对、报错、还是不行”——最接近“用得好不好”的信号"
    }
  },
  "verdict_labels": {
    "good": "做对了",
    "bad": "用错了",
    "unused": "没用上",
    "na": "数据不足",
